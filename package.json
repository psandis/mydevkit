{
  "name": "mydevkit",
  "version": "0.1.1",
  "description": "mydevkit: small everyday developer tools (passwords, tokens, UUIDs, file hashes)",
  "keywords": [
    "cli",
    "password",
    "token",
    "uuid",
    "hash",
    "sha256",
    "developer-tools"
  ],
  "author": "Petri Sandholm <petri.sandholm@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/psandis/mydevkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psandis/mydevkit.git"
  },
  "bugs": {
    "url": "https://github.com/psandis/mydevkit/issues"
  },
  "type": "module",
  "bin": {
    "mydk": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint ./src ./tests",
    "format": "biome format ./src ./tests --write",
    "check": "biome check ./src ./tests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test"
  },
  "private": false,
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
